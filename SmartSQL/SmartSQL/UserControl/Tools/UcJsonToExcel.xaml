<local:BaseUserControl
    x:Class="SmartSQL.UserControl.UcJsonToExcel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SmartSQL.UserControl"
    xmlns:localBase="clr-namespace:SmartSQL.UserControl.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SmartSQL.Models"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:userControl="clr-namespace:SmartSQL.UserControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Margin="5"
        Background="White"
        CornerRadius="8">
        <Grid Margin="18">
            <Grid
                Height="40"
                Margin="0,-5,0,0"
                VerticalAlignment="Top"
                Background="#f9f9f9">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesome
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77"
                        Icon="Inbox" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        工具箱
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        /
                    </TextBlock>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#5c6b77">
                        Json转Excel
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    Margin="10,10,10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockSubTitleBold}"
                    Text="Json转Excel" />
                <Button
                    x:Name="BtnReturn"
                    Width="60"
                    Height="28"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0.4"
                    Click="BtnReturn_Click"
                    Content="返回"
                    Cursor="Hand" />
            </Grid>
            <Border
                Margin="0,45,0,0"
                Background="#f9f9f9"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4.5*" MinHeight="30" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <!--Json文本框-->
                    <DockPanel
                        Grid.Row="0"
                        Grid.Column="0">
                        <avalonedit:TextEditor
                        x:Name="TextEditor"
                        Margin="10,10,10,5"
                        Padding="0,5,5,5"
                        FontFamily="新宋体"
                        FontSize="15"
                        VerticalAlignment="Top"
                        GotFocus="TextEditor_GotFocus"
                        ShowLineNumbers="True"
                        WordWrap="True">
                            <avalonedit:TextEditor.Options>
                                <avalonedit:TextEditorOptions ShowSpaces="False">
                                    <avalonedit:TextEditorOptions.ColumnRulerPosition>
                                        <system:Int32>10</system:Int32>
                                    </avalonedit:TextEditorOptions.ColumnRulerPosition>
                                </avalonedit:TextEditorOptions>
                            </avalonedit:TextEditor.Options>
                        </avalonedit:TextEditor>

                    </DockPanel>

                    <!--  分割线  -->
                    <GridSplitter
                        Grid.Row="1"
                        Grid.Column="0"
                        Height="5"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Style="{StaticResource GridSplitterHorizontal}" />


                    <DockPanel Grid.Row="2" Grid.Column="0" >
                        <Grid>
                            <!--按钮栏-->
                            <Grid Margin="10 0 10 0" VerticalAlignment="Top">
                                <StackPanel
                            Height="30"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnConvert"
                                        Width="80"
                                        Height="28"
                                        hc:IconElement.Geometry="{StaticResource StartGeometry}"
                                        Click="BtnConvert_Click"
                                        Content="转换"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonSuccess}" />
                                    <Button
                                        x:Name="BtnFormatter"
                                        Width="80"
                                        Height="28"
                                        Margin="10,0,0,0"
                                        hc:IconElement.Geometry="{StaticResource CodeEGeometry}"
                                        Click="BtnFormatter_Click"
                                        Content="格式化"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonWarning}" />
                                    <Button
                                        x:Name="BtnCompress"
                                        Width="80"
                                        Height="28"
                                        Margin="10,0,0,0"
                                        hc:IconElement.Geometry="{StaticResource YaSuoGeometry}"
                                        Click="BtnCompress_Click"
                                        Content="压缩"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonWarning}" />

                                </StackPanel>
                                <StackPanel
                                        HorizontalAlignment="Right"  Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnSave"
                                        Width="80"
                                        Height="28"
                                        HorizontalAlignment="Right"    
                                        hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
                                        Click="BtnSave_Click"
                                        Content="另存为"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonPrimary}" >
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Name="CMeneExport"
                                                Width="150"
                                                Visibility="Visible">
                                                <MenuItem
                                                    x:Name="MenuSaveCsv"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Click="MenuSaveCsv_Click"
                                                    Header="CSV">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource Fa_Solid_FileCsv}" Fill="ForestGreen" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    x:Name="MenuSaveExcel"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Click="MenuSaveExcel_Click"
                                                    Header="Excel">
                                                    <MenuItem.Icon>
                                                        <fa:FontAwesome
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="ForestGreen"
                                                            Icon="FileExcelOutline" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button
                                        x:Name="BtnClear"
                                        Width="80"
                                        Height="28"
                                        Margin="10,0,0,0"                                  
                                        hc:IconElement.Geometry="{StaticResource ClearGeometry}"
                                        BorderThickness="0.6"
                                        Click="BtnClear_Click"
                                        Content="清空"
                                        Cursor="Hand" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#fff" Margin="10 40 10 10">
                                <Grid>
                                    <DataGrid
                                        x:Name="TableGrid"
                                        Margin="5,5,5,5"
                                         VerticalAlignment="Top"
                                        hc:DataGridAttach.CanUnselectAllWithBlankArea="True"
                                        hc:DataGridAttach.ShowRowNumber="True"
                                        AutoGenerateColumns="True"
                                        Background="Transparent"
                                        ColumnWidth="Auto"
                                        Cursor="Arrow"
                                        HeadersVisibility="All"
                                        IsReadOnly="True"
                                        RowHeaderWidth="60"
                                        SelectionUnit="CellOrRowHeader">
                                    </DataGrid>
                                    <Grid
                                        x:Name="NoDataTextExt"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        Background="White"
                                        Cursor="Arrow">
                                        <localBase:NoDataArea Margin="0" HorizontalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:BaseUserControl>
